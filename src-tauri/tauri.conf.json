{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droidlog",
  "version": "0.1.0",
  "identifier": "dev.droidlog.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Droidlog — Android 日志采集",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "backgroundColor": "#121517"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "platform-tools/adb.exe",
      "platform-tools/AdbWinApi.dll",
      "platform-tools/AdbWinUsbApi.dll",
      "platform-tools/NOTICE.txt",
      "platform-tools/source.properties"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Android log collection",
    "longDescription": "Collect logcat / dmesg / kmsg from Android devices over ADB or Root (su -c), with real-time filtering and export."
  }
}
